# ===================================================================
# FinalB5 - Sistema de Gestion de Pedidos y Delivery
# Archivo de Configuracion de Variables de Entorno (.env.example)
# ===================================================================

# Puertos de Servicios
GATEWAY_PORT=8000
AUTH_PORT=8081
COMERCIO_PORT=8082
PEDIDO_PORT=8083

# Credenciales de Base de Datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=admin

# URLs JDBC de Bases de Datos Microservicios
DB_AUTH_URL=jdbc:postgresql://localhost:5432/delivery_auth_db
DB_COMERCIO_URL=jdbc:postgresql://localhost:5432/delivery_comercio_db
DB_PEDIDO_URL=jdbc:postgresql://localhost:5432/delivery_pedido_db

# URLs de Comunicacion Inter-Servicios
AUTH_SERVICE_URL=http://localhost:8081
COMERCIO_SERVICE_URL=http://localhost:8082
PEDIDO_SERVICE_URL=http://localhost:8083

# Seguridad JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
