# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - SISTEMA DELIVERY MICROSERVICIOS
# ==============================================================================

# Clave secreta para firma y verificación de tokens JWT (HS256 - mínimo 256 bits)
JWT_SECRET=CAMBIAR_POR_UN_SECRET_SEGURO_DE_AL_MENOS_256_BITS
JWT_EXPIRATION=86400000

# Secreto interno para comunicación segura entre microservicios
INTERNAL_API_SECRET=CAMBIAR_POR_UN_SECRET_INTERNO_SEGURO

# Credenciales de Base de Datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=admin

# URLs de conexión PostgreSQL por servicio
DB_AUTH_URL=jdbc:postgresql://localhost:5432/delivery_auth_db
DB_COMERCIO_URL=jdbc:postgresql://localhost:5432/delivery_comercio_db
DB_PEDIDO_URL=jdbc:postgresql://localhost:5432/delivery_pedido_db

# Puertos de los servicios
GATEWAY_PORT=8000
AUTH_PORT=8081
COMERCIO_PORT=8082
PEDIDO_PORT=8083

# URLs de servicios para Gateway y Feign/WebClient
AUTH_SERVICE_URL=http://localhost:8081
COMERCIO_SERVICE_URL=http://localhost:8082
PEDIDO_SERVICE_URL=http://localhost:8083
